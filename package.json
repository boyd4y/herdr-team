{
  "name": "herdr-team-skill",
  "version": "0.1.56",
  "private": true,
  "description": "Shared Herdr Team skill and CLI, independent of the TUI and Desktop presentation packages.",
  "scripts": {
    "test": "cd cli && bun test",
    "test:install": "node --test tests/*.test.cjs",
